{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-editor",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64",
        "-DCMAKE_PREFIX_PATH=${config:cmake.configureSettings.CMAKE_PREFIX_PATH}",
        "-DBUFFALO_BUILD_TESTS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-editor",
        "--config",
        "Debug",
        "--parallel",
        "--target",
        "BuffaloEditor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: build Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-editor",
        "--config",
        "Release",
        "--parallel",
        "--target",
        "BuffaloEditor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: build tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build-editor", "--config", "Debug", "--parallel"],
      "dependsOn": "CMake: configure",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CTest: regression",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "${workspaceFolder}/build-editor", "-C", "Debug", "--output-on-failure"],
      "dependsOn": "CMake: build tests",
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    }
  ]
}
