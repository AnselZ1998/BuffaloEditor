QWidget { color: #d3d7dc; font-family: "Segoe UI"; font-size: 12px; }
QMainWindow, QDialog { background: #292c30; }
QMenuBar { background: #25282c; padding: 3px 8px; border-bottom: 1px solid #191c20; }
QMenuBar::item { padding: 5px 10px; }
QMenuBar::item:selected, QMenu::item:selected { background: #46403a; }
QMenu { background: #30343a; border: 1px solid #181b1e; padding: 4px; }
QMenu::item { padding: 6px 26px; }
QMenu::separator { height: 1px; background: #42464c; margin: 4px; }
QToolBar { background: #30343a; border: none; spacing: 5px; padding: 5px 8px; }
QToolBar::separator { background: #454a51; width: 1px; margin: 3px 8px; }
QToolButton, QPushButton { background: #383d44; border: 1px solid transparent; border-radius: 2px; padding: 4px 9px; }
QToolButton:hover, QPushButton:hover { background: #454b53; }
QToolButton:checked, QToolButton:pressed, QPushButton:pressed { background: #5e4d37; border-color: #aa834f; }
QToolButton:disabled, QPushButton:disabled { color: #747b85; background: #2e3237; }
QWidget#ViewportToolbar { background: #2c3035; border-right: 1px solid #181c20; }
QWidget#ViewportToolbar QToolButton { padding: 3px; }
QDockWidget::title { background: #34393f; padding: 7px 10px; border-bottom: 1px solid #1c2024; }
QDockWidget::close-button, QDockWidget::float-button { border: none; padding: 2px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: #505761; }
QMainWindow::separator { background: #1d2024; width: 4px; height: 4px; }
QMainWindow::separator:hover { background: #a8814c; }
QLineEdit, QComboBox { background: #24282d; border: 1px solid #424851; border-radius: 2px; padding: 4px 7px; }
QComboBox { min-width: 82px; padding-right: 22px; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView { background: #30343a; selection-background-color: #665039; }
QLineEdit:focus, QComboBox:focus { border-color: #aa834f; }
QTreeWidget, QPlainTextEdit { background: #23272c; border: none; selection-background-color: #665039; }
QTreeWidget::item { padding: 5px; }
QHeaderView::section { background: #2c3137; border: none; padding: 6px; color: #aeb6c0; }
QPlainTextEdit#LogMessages { font-family: "Consolas"; font-size: 12px; }
QScrollBar:vertical { background: #282c31; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #555d68; min-height: 26px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #282c31; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #555d68; min-width: 26px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QStatusBar { background: #282c31; border-top: 1px solid #1c2024; }
QStatusBar::item { border: none; }
QLabel#BuffaloBrand { color: #e2bd83; font-size: 14px; font-weight: 600; letter-spacing: 2px; }
QLabel#PanelHint { color: #949da9; padding: 7px; font-size: 11px; }
QLabel#ViewportTitle { color: #dde1e7; font-weight: 600; }
QToolTip { background: #343940; color: #e1e5eb; border: 1px solid #59616c; padding: 5px; }

/* Simulation timeline only; preserve all existing editor styling. */
QWidget#SimulationPanel { background: #292d32; border-top: 1px solid #1c2024; }
QSlider#SimulationTimeline { background: #24282d; color: #aeb6c0; border: none; }
QWidget#SimulationPanel QPushButton { padding: 3px 8px; }
QWidget#SimulationPanel QSpinBox { background: #202429; border: 1px solid #424851; padding: 3px 6px; }
QWidget#SimulationPanel QSpinBox:focus { border-color: #aa834f; }
QLabel#SimulationState { color: #d0a767; }
QLabel#SimulationTime { color: #aeb6c0; font-family: "Consolas"; }